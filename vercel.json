{
  "version": 2,
  "functions": {
    "api/index.js": {
      "includeFiles": "dist/**",
      "memory": 512,
      "maxDuration": 60
    }
  },
  "crons": [
    { "path": "/api/cron/followups", "schedule": "0 4 * * *" }
  ],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index" },
    { "source": "/admin", "destination": "/api/index" },
    { "source": "/(.*)", "destination": "/api/index" }
  ]
}
